# Copy this file to .env for running on your computer. On Vercel, add these under Settings → Environment Variables.

# Supabase → Connect → Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API (or API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# First staff login (used only when the database has no admin yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional: address used in QR codes (defaults to the site address)
# PUBLIC_URL=https://maitri-cafe.vercel.app
